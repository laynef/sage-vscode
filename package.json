{
  "name": "local-keep-ai",
  "publisher": "localkeepai",
  "displayName": "Local Keep AI",
  "description": "Local-first AI coding assistant — 1,000+ free models, no API key required",
  "version": "1.0.1",
  "icon": "media/lk-logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/laynef/localkeep-vscode"
  },
  "homepage": "https://localkeep.ai",
  "bugs": {
    "url": "https://github.com/laynef/localkeep-vscode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "copilot",
    "llm",
    "local",
    "ollama",
    "free",
    "sage"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "lk.explain",
        "title": "Local Keep AI: Explain Selection",
        "category": "Local Keep AI"
      },
      {
        "command": "lk.refactor",
        "title": "Local Keep AI: Refactor Selection",
        "category": "Local Keep AI"
      },
      {
        "command": "lk.generateTests",
        "title": "Local Keep AI: Generate Tests for File",
        "category": "Local Keep AI"
      },
      {
        "command": "lk.fixError",
        "title": "Local Keep AI: Fix Error at Cursor",
        "category": "Local Keep AI"
      },
      {
        "command": "lk.openChat",
        "title": "Local Keep AI: Open Chat Panel",
        "category": "Local Keep AI"
      },
      {
        "command": "lk.commitMessage",
        "title": "Local Keep AI: Generate Commit Message",
        "category": "Local Keep AI"
      },
      {
        "command": "lk.prDescription",
        "title": "Local Keep AI: Generate PR Description",
        "category": "Local Keep AI"
      },
      {
        "command": "lk.listModels",
        "title": "Local Keep AI: Switch Model",
        "category": "Local Keep AI"
      },
      {
        "command": "lk.runPrompt",
        "title": "Local Keep AI: Run Agentic Task...",
        "category": "Local Keep AI"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "lk.explain",
          "when": "editorHasSelection",
          "group": "sage@1"
        },
        {
          "command": "lk.refactor",
          "when": "editorHasSelection",
          "group": "sage@2"
        },
        {
          "command": "lk.generateTests",
          "group": "sage@3"
        },
        {
          "command": "lk.fixError",
          "when": "editorHasSelection",
          "group": "sage@4"
        }
      ],
      "scm/title": [
        {
          "command": "lk.commitMessage",
          "group": "sage"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lk.openChat",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s"
      },
      {
        "command": "lk.explain",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorHasSelection"
      },
      {
        "command": "lk.refactor",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorHasSelection"
      },
      {
        "command": "lk.fixError",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Local Keep AI",
      "properties": {
        "lk.model": {
          "type": "string",
          "default": "",
          "description": "Model to use (blank = ~/.sage/config.json default)"
        },
        "lk.autoComplete": {
          "type": "boolean",
          "default": false,
          "description": "Enable inline ghost-text completions (adds latency)"
        },
        "lk.contextLines": {
          "type": "number",
          "default": 50,
          "description": "Lines of surrounding context to include"
        },
        "lk.apiBase": {
          "type": "string",
          "default": "https://localkeep.ai",
          "description": "Override API base URL"
        }
      }
    }
  }
}
